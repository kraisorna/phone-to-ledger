# Secrets must never be committed. Adapters read MODEL_API_KEY from the
# environment first, then from a project-root .env (see adapters/env.py).
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Data (DVC-managed / collected, not committed)
data/dev/
data/test/
data/labels/

# Export outputs
*.xlsx

# Runtime artifacts (regenerable; never commit). Anchored at root so
# demo/ fixtures (demo/expected.csv, demo/review/) stay committable.
/review/
/seen.json
/ledger.csv
# Doc-example outputs (README/DEMO run e2e into these names).
demo/out.json
demo/ledger.csv

# macOS
.DS_Store
